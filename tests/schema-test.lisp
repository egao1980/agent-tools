(in-package #:agent-tools/tests)

;;; LIST-AGENT-TOOLS descriptors: names, descriptions and draft-07 JSON
;;; Schema parameters as json-protocol values (string-keyed hash tables,
;;; vectors for arrays, NIL for false).

(defun hash-keys (h)
  (sort (loop for k being the hash-keys of h collect k) #'string<))

(defun tool-named (tools name)
  (find name (a:list-agent-tools tools) :key #'llm:llm-tool-name :test #'equal))

(deftest list-agent-tools-names-and-descriptions
  (with-tools (tools root :memory) '()
    (let ((descs (a:list-agent-tools tools)))
      (ok (= 7 (length descs)))
      (ok (every #'llm:llm-tool-p descs))
      (ok (equal +file-tool-names+ (mapcar #'llm:llm-tool-name descs)))
      (ok (every (lambda (d)
                   (let ((s (llm:llm-tool-description d)))
                     (and (stringp s) (> (length s) 20))))
                 descs)
          "every tool has a real description")
      (ok (not (eq (first descs) (first (a:list-agent-tools tools))))
          "fresh descriptors per call"))))

(deftest-parametrize tool-parameter-schemas
    ((name required props)
     :ids ("read" "write" "edit" "multi_edit" "glob" "grep" "ls")
     ("read" '("file_path")
      '(("file_path" "string") ("offset" "integer") ("limit" "integer")))
     ("write" '("file_path" "content")
      '(("file_path" "string") ("content" "string") ("expected_hash" "string")))
     ("edit" '("file_path" "old_string" "new_string")
      '(("file_path" "string") ("old_string" "string") ("new_string" "string")
        ("replace_all" "boolean") ("expected_hash" "string")))
     ("multi_edit" '("file_path" "edits")
      '(("file_path" "string") ("edits" "array") ("expected_hash" "string")))
     ("glob" '("pattern")
      '(("pattern" "string") ("path" "string")))
     ("grep" '("pattern")
      '(("pattern" "string") ("path" "string") ("include" "string")
        ("regex" "boolean") ("case_insensitive" "boolean") ("max_results" "integer")))
     ("ls" '()
      '(("path" "string"))))
  (with-tools (tools root :memory) '()
    (let* ((desc (tool-named tools name))
           (params (and desc (llm:llm-tool-parameters desc))))
      (ok (hash-table-p params))
      (when (hash-table-p params)
        (ok (equal "object" (gethash "type" params)))
        (ok (null (nth-value 1 (gethash "$schema" params))) "no $schema key")
        (multiple-value-bind (v found) (gethash "additionalProperties" params)
          (ok (and found (null v)) "additionalProperties false"))
        (if required
            (ok (equalp (coerce required 'vector) (gethash "required" params)))
            (ok (null (nth-value 1 (gethash "required" params)))
                "no required key when nothing is required"))
        (let ((properties (gethash "properties" params)))
          (ok (hash-table-p properties))
          (when (hash-table-p properties)
            (ok (equal (sort (mapcar #'first props) #'string<) (hash-keys properties)))
            (loop for (prop type) in props
                  for schema = (gethash prop properties)
                  do (ok (equal type (and (hash-table-p schema) (gethash "type" schema)))
                         (format nil "~a.~a is ~a" name prop type))
                     (ok (stringp (and (hash-table-p schema) (gethash "description" schema)))
                         (format nil "~a.~a has a description" name prop)))))
        (ok (stringp (json:encode params)) "encodes as JSON")))))

(deftest multi-edit-items-schema
  (with-tools (tools root :memory) '()
    (let* ((params (llm:llm-tool-parameters (tool-named tools "multi_edit")))
           (edits (gethash "edits" (gethash "properties" params)))
           (items (gethash "items" edits)))
      (ok (equal "array" (gethash "type" edits)))
      (ok (eql 1 (gethash "minItems" edits)))
      (ok (equal "object" (gethash "type" items)))
      (ok (equalp #("old_string" "new_string") (gethash "required" items)))
      (ok (equal '("new_string" "old_string" "replace_all")
                 (hash-keys (gethash "properties" items))))
      (ok (equal "boolean" (gethash "type" (gethash "replace_all" (gethash "properties" items))))))))
