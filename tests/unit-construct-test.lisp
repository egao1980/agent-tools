(in-package #:agent-tools/tests)

;;; H8c: constructing UNIT-TOOLS, descriptors and schemas, approval, closing.

(defun schema-of (tools name)
  (llm:llm-tool-parameters (find name (a:list-agent-tools tools) :key #'llm:llm-tool-name
                                                                 :test #'equal)))

(defun prop (schema name &optional key)
  (let ((p (gethash name (gethash "properties" schema))))
    (if key (gethash key p) p)))

(deftest unit-tools-defaults
  (with-units (tools sup)
    (ok (unit-tools-p tools))
    (ok (eq sup (unit-tools-supervisor tools)))
    (ok (typep (unit-tools-index tools) 'ss:log-index))
    (ok (eq (sup:supervisor-root-scope sup) (unit-tools-scope tools)))
    (ok (eq t (unit-tools-previous tools)))
    (ok (eq t (unit-tools-needs-approval tools)))
    (ok (equal '(30000 100 10 50 2 10 2000 600000)
               (list (unit-tools-max-output tools) (unit-tools-max-results tools)
                     (unit-tools-default-k tools) (unit-tools-max-k tools)
                     (unit-tools-context tools) (unit-tools-max-context tools)
                     (unit-tools-max-read-lines tools) (unit-tools-max-wait tools))))
    (ok (equal +unit-tool-names+ (unit-tools-names tools)))
    (ok (equal '("unit_list" "unit_search" "unit_read" "unit_tail" "unit_control") +unit-tool-names+))
    (ok (equal '("error" "warning" "stack-trace" "test-failure" "exit") +unit-search-kinds+))
    (ok (equal '("stop" "restart" "input") +unit-control-actions+))
    (ok (= 500 +max-excerpt-line+))
    (ok (not (unit-tools-closed-p tools)))))

(deftest unit-tools-construction-errors
  (ok (failure (make-unit-tools)) "a supervisor is required")
  (ok (failure (make-unit-tools :supervisor 42)))
  (with-units (tools sup)
    (let ((other (sup:make-supervisor :exit-hook nil)))
      (unwind-protect
           (ok (failure (make-unit-tools :supervisor sup :scope (sup:supervisor-root-scope other)))
               "a scope of another supervisor")
        (quiet-shutdown other)))
    (ok (failure (make-unit-tools :supervisor sup :tools '("unit_list" "unit_nope"))))
    (ok (failure (make-unit-tools :supervisor sup :default-k 60)))
    (ok (failure (make-unit-tools :supervisor sup :context 11)))
    (let ((some (make-unit-tools :supervisor sup :tools '("unit_tail" "unit_list"))))
      (ok (equal '("unit_list" "unit_tail") (unit-tools-names some)) "kept in +UNIT-TOOL-NAMES+ order"))))

(deftest unit-tools-descriptors-and-schemas
  (with-units (tools sup)
    (ok (equal +unit-tool-names+ (mapcar #'llm:llm-tool-name (a:list-agent-tools tools))))
    (dolist (name +unit-tool-names+)
      (let ((s (schema-of tools name)))
        (ok (equal "object" (gethash "type" s)) name)
        (ok (null (gethash "additionalProperties" s)) "additionalProperties false")
        (maphash (lambda (k v) (ok (stringp (gethash "description" v)) k))
                 (gethash "properties" s))
        (ok (plusp (length (llm:llm-tool-description
                            (find name (a:list-agent-tools tools) :key #'llm:llm-tool-name :test #'equal)))))))
    (ok (null (gethash "required" (schema-of tools "unit_list"))))
    (ok (null (gethash "required" (schema-of tools "unit_read"))))
    (ok (equalp #("query") (gethash "required" (schema-of tools "unit_search"))))
    (ok (equalp #("unit") (gethash "required" (schema-of tools "unit_tail"))))
    (ok (equalp #("unit" "action") (gethash "required" (schema-of tools "unit_control"))))
    (let ((s (schema-of tools "unit_search")))
      (ok (= 50 (prop s "k" "maximum")))
      (ok (= 1 (prop s "k" "minimum")))
      (ok (= 10 (prop s "context" "maximum")))
      (ok (equalp (coerce +unit-search-kinds+ 'vector) (gethash "enum" (prop s "kinds" "items"))))
      (ok (equalp #("stdout" "stderr") (gethash "enum" (prop s "streams" "items")))))
    (ok (equalp (coerce +unit-control-actions+ 'vector)
                (prop (schema-of tools "unit_control") "action" "enum")))
    (ok (= 600000 (prop (schema-of tools "unit_tail") "wait_ms" "maximum")))
    (ok (= 2000 (prop (schema-of tools "unit_read") "limit" "maximum")))
    (ok (equalp #("live" "finished" "starting" "running" "exited" "failed" "killed")
                (prop (schema-of tools "unit_list") "state" "enum")))))

(deftest unit-tools-approval
  (with-units (tools sup)
    (dolist (name +unit-tool-names+)
      (ok (eq (equal name "unit_control")
              (a:tool-needs-approval-p tools name (json-args "unit" "x" "action" "stop")))
          name))
    (ok (a:tool-executable-p tools "unit_search"))
    (ok (not (a:tool-executable-p tools "bash"))))
  (with-units (tools sup :tool-keys (:needs-approval nil))
    (ok (not (a:tool-needs-approval-p tools "unit_control" (json-args "unit" "x" "action" "stop"))))))

(deftest unit-tools-unknown-and-closed
  (with-units (tools sup :tool-keys (:tools '("unit_list")))
    (ok (typep (failure (ucall tools "unit_search" "query" "x")) 'a:agent-unknown-tool))
    (ok (typep (failure (ucall tools "bash" "command" "ls")) 'a:agent-unknown-tool))
    (ok (null (close-unit-tools tools)))
    (ok (null (close-unit-tools tools)) "idempotent")
    (ok (unit-tools-closed-p tools))
    (ok (ss:index-closed-p (unit-tools-index tools)) "the tools' own index is closed")
    (ok (typep (failure (ucall tools "unit_list")) 'a:tool-unavailable)))
  (with-units (tools sup)
    (let* ((index (ss:make-log-index :supervisor sup))
           (mine (make-unit-tools :supervisor sup :index index)))
      (close-unit-tools mine)
      (ok (not (ss:index-closed-p index)) "an index passed in stays open")
      (ss:close-log-index index))))
